    <!-- HOW IT WORKS (Simple 4-Step Horizontal Process) -->
    <section class="section how-it-works-section" id="how-it-works">
      <div class="container">
        <div class="section-header">
          <span class="section-label" data-i18n="process_label">SIMPLE PATIENT JOURNEY</span>
          <h2 class="section-title" data-i18n="process_heading">How It Works</h2>
          <p class="section-subtitle" data-i18n="process_sub">A seamless four-step process engineered for comfort, hygiene, and fast turnaround.</p>
        </div>

        <div class="process-steps-container">
          <!-- Step 01 -->
          <div class="step-card">
            <div class="step-number-bubble">01</div>
            <h3 class="step-title" data-i18n="step1_title">Book / Visit</h3>
            <p class="step-desc" data-i18n="step1_desc">Schedule your test online, request home sample collection, or walk directly into our Ponneri laboratory.</p>
          </div>

          <!-- Step 02 -->
          <div class="step-card">
            <div class="step-number-bubble">02</div>
            <h3 class="step-title" data-i18n="step2_title">Sample Collection</h3>
            <p class="step-desc" data-i18n="step2_desc">Hygienic collection by certified phlebotomists using sterilized, vacuum-sealed disposable equipment.</p>
          </div>

          <!-- Step 03 -->
          <div class="step-card">
            <div class="step-number-bubble">03</div>
            <h3 class="step-title" data-i18n="step3_title">Laboratory Testing</h3>
            <p class="step-desc" data-i18n="step3_desc">Precision processing on automated clinical analyzers with rigorous internal quality control.</p>
          </div>

          <!-- Step 04 -->
          <div class="step-card">
            <div class="step-number-bubble">04</div>
            <h3 class="step-title" data-i18n="step4_title">Receive Your Report</h3>
            <p class="step-desc" data-i18n="step4_desc">Obtain verified physical printed reports at our clinic or get digital copies via WhatsApp and Email.</p>
