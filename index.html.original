    <!-- ABOUT SECTION (Two-Column) -->
    <section class="section about-section" id="about">
      <div class="container">
        <div class="about-grid">
          <!-- Left: Professional Lab Image -->
          <div class="about-media-col">
            <div class="about-image-card">
              <img src="assets/images/about-lab.jpg" alt="Experienced Pathologist analyzing sample at Sri Durgaa Clinical Laboratory" width="560" height="460" loading="lazy">
            </div>
            <div class="about-floating-experience">
              <span class="exp-number" data-i18n="about_exp_years">25</span>
              <div class="exp-text">
                <strong data-i18n="about_exp_title">Years of Trust</strong><br>
                <span data-i18n="about_exp_sub">Diagnostic Excellence in Ponneri</span>
              </div>
            </div>
          </div>

          <!-- Right: About Details -->
          <div class="about-content-col">
            <span class="section-label" data-i18n="about_label">ABOUT US</span>
            <h2 class="about-heading" data-i18n="about_heading">25 Years of Trust in Diagnostic Care</h2>
            <p class="about-lead-desc" data-i18n="about_lead">
              Sri Durgaa Clinical Laboratory has been serving patients with reliable diagnostic testing for over 25 years. Our focus is on accurate testing, quality laboratory practices, timely reports and dependable patient service.
            </p>

            <div class="about-checklist">
              <div class="about-check-item">
