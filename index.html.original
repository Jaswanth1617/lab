  <title>Sri Durgaa Clinical Laboratory | Diagnostic Centre in Ponneri</title>
  <meta name="description" content="Sri Durgaa Clinical Laboratory in Ponneri, Tamil Nadu. 25+ years of experience providing reliable diagnostic testing, pathology, blood tests, ECG, Digital X-Ray & health checkups.">
  <meta name="keywords" content="Sri Durgaa Clinical Laboratory, Diagnostic Centre Ponneri, Blood Test Ponneri, Pathology Lab Ponneri, CBC Test, KFT, LFT, ECG, Digital X-Ray Ponneri">
  
  <!-- Open Graph / Meta -->
  <meta property="og:title" content="Sri Durgaa Clinical Laboratory | 25+ Years of Trusted Diagnostic Care">
  <meta property="og:description" content="Accurate Tests. Trusted Care. Better Health. Ponneri, Tamil Nadu.">
  <meta property="og:type" content="website">
  <meta property="og:image" content="assets/images/hero-lab.jpg">

  <!-- Favicon / Vector Icon -->
