          <button type="button" class="lang-btn" data-lang="ta" aria-label="தமிழுக்கு மாற்றவும்" title="தமிழுக்கு மாற்றவும்">தமிழ்</button>
        </div>

        <button type="button" class="btn-search-trigger" id="headerSearchBtn" title="Search Tests & Services" aria-label="Search tests" data-i18n-title="search_label" data-i18n-aria="search_label">
