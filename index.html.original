    <!-- TESTS SECTION (11 Tests with Cards, Category Tabs & Live Search) -->
    <section class="section tests-section" id="tests">
      <div class="container">
        <div class="section-header">
          <span class="section-label" data-i18n="tests_label">DIAGNOSTIC EXCELLENCE</span>
          <h2 class="section-title" data-i18n="tests_heading">Diagnostic Tests</h2>
          <p class="section-subtitle" data-i18n="tests_sub">Comprehensive laboratory testing for your healthcare needs.</p>
        </div>

        <!-- Filter & Search Controls -->
        <div class="test-search-filter-bar">
          <div class="test-search-box">
            <svg class="test-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="testSearchInput" class="test-search-input" placeholder="Search tests (e.g., CBC, Sugar, Thyroid, ECG)..." aria-label="Search diagnostic tests" data-i18n-placeholder="tests_search_placeholder">
          </div>

          <div class="filter-categories" role="tablist">
            <button type="button" class="category-tab active" data-category="all" data-i18n="tab_all">All Tests (11)</button>
            <button type="button" class="category-tab" data-category="Blood & Pathology" data-i18n="tab_blood">Blood & Pathology</button>
            <button type="button" class="category-tab" data-category="Organ Profiles" data-i18n="tab_organ">Organ Profiles</button>
            <button type="button" class="category-tab" data-category="Imaging & Cardiac" data-i18n="tab_imaging">Imaging & Cardiac</button>
            <button type="button" class="category-tab" data-category="Specialized Screenings" data-i18n="tab_specialized">Specialized Screenings</button>
          </div>
        </div>

        <!-- The 11 Tests Grid -->
        <div class="tests-grid" id="testsGridContainer">
          
          <!-- 1. CBC – Complete Blood Count -->
          <article class="test-card" data-category="Blood & Pathology" data-name="CBC Complete Blood Count">
