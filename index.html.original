  <!-- Modal 2: Book a Test / Home Collection Modal -->
  <div class="modal-backdrop" id="bookTestModal" role="dialog" aria-modal="true" aria-labelledby="bookTestTitle">
    <div class="modal-container">
      <div class="modal-header">
        <h3 class="modal-title" id="bookTestTitle" data-i18n="book_modal_title">Schedule a Diagnostic Test</h3>
        <button type="button" class="modal-close-btn" aria-label="Close booking modal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="modal-body">
        <div style="background: #e8f5e9; border: 1px solid #c8e6c9; border-radius: var(--radius-sm); padding: 12px 14px; margin-bottom: 18px; display: flex; align-items: flex-start; gap: 10px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          <div style="font-size: 0.85rem; color: #1b5e20; line-height: 1.45;" data-i18n="book_wa_notice">
            <strong>Automated WhatsApp Booking:</strong> Submitting this form will automatically prepare and send your booking confirmation directly to our lab WhatsApp (<a href="https://wa.me/919843696625" target="_blank" rel="noopener" style="color: #1b5e20; font-weight: 700; text-decoration: underline;">+91 98436 96625</a>) for immediate verification.
          </div>
        </div>

        <p style="font-size: 0.92rem; color: var(--text-muted); margin-bottom: 20px;" data-i18n="book_modal_sub">
          Choose whether you wish to visit our Ponneri diagnostic centre or request convenient home sample collection.
        </p>

        <form id="bookingForm">
          <!-- Visit Type Radio Selector -->
          <div class="form-group">
            <label class="form-label" data-i18n="book_label_pref">Service Preference *</label>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <label style="border: 1px solid var(--border-color); padding: 12px; border-radius: var(--radius-sm); display: flex; align-items: center; gap: 10px; cursor: pointer;">
                <input type="radio" name="collectionType" value="lab" checked>
                <div>
                  <strong style="display: block; font-size: 0.9rem; color: var(--dark-blue);" data-i18n="book_radio_lab_title">Lab Visit</strong>
                  <span style="font-size: 0.78rem; color: var(--text-muted);" data-i18n="book_radio_lab_sub">Ponneri Centre</span>
                </div>
              </label>
              <label style="border: 1px solid var(--border-color); padding: 12px; border-radius: var(--radius-sm); display: flex; align-items: center; gap: 10px; cursor: pointer;">
                <input type="radio" name="collectionType" value="home">
                <div>
                  <strong style="display: block; font-size: 0.9rem; color: var(--primary);" data-i18n="book_radio_home_title">Home Collection</strong>
                  <span style="font-size: 0.78rem; color: var(--text-muted);" data-i18n="book_radio_home_sub">At your doorstep</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Select Test or Package -->
          <div class="form-group">
            <label for="bookingTestSelect" class="form-label" data-i18n="book_label_select">Select Test or Health Package *</label>
            <select id="bookingTestSelect" class="form-control" required>
              <optgroup label="Diagnostic Tests">
                <option value="CBC – Complete Blood Count">CBC – Complete Blood Count</option>
                <option value="KFT – Kidney Function Test">KFT – Kidney Function Test</option>
                <option value="LFT – Liver Function Test">LFT – Liver Function Test</option>
                <option value="Lipid Profile">Lipid Profile</option>
                <option value="Blood Sugar Test">Blood Sugar Test</option>
                <option value="Thyroid Profile">Thyroid Profile</option>
                <option value="Urine &amp; Stool Test">Urine &amp; Stool Test</option>
                <option value="ECG">ECG</option>
                <option value="Digital X-Ray">Digital X-Ray</option>
                <option value="HIV Test">HIV Test</option>
                <option value="Pregnancy Test">Pregnancy Test</option>
              </optgroup>
              <optgroup label="Health Checkup Packages">
                <option value="Basic Health Checkup">Basic Health Checkup</option>
                <option value="Complete Health Checkup">Complete Health Checkup (Recommended)</option>
                <option value="Advanced Health Checkup">Advanced Health Checkup</option>
              </optgroup>
            </select>
          </div>

          <!-- Date & Time Slot -->
          <div class="form-grid">
            <div class="form-group">
              <label for="bookingDate" class="form-label" data-i18n="book_label_date">Preferred Date *</label>
              <input type="date" id="bookingDate" class="form-control" required>
            </div>
            <div class="form-group">
              <label for="bookingTime" class="form-label" data-i18n="book_label_time">Preferred Time Slot *</label>
              <select id="bookingTime" class="form-control" required>
                <option value="07:00 AM - 08:30 AM (Fasting Slot)">07:00 AM - 08:30 AM (Fasting Slot)</option>
                <option value="08:30 AM - 10:00 AM">08:30 AM - 10:00 AM</option>
                <option value="10:00 AM - 12:00 PM">10:00 AM - 12:00 PM</option>
                <option value="04:00 PM - 06:00 PM">04:00 PM - 06:00 PM</option>
                <option value="06:00 PM - 08:00 PM">06:00 PM - 08:00 PM</option>
              </select>
            </div>
          </div>

          <!-- Patient Information -->
          <div class="form-grid">
            <div class="form-group">
              <label for="patientName" class="form-label" data-i18n="book_label_patient">Patient Name *</label>
              <input type="text" id="patientName" class="form-control" placeholder="Patient's Full Name" data-i18n-placeholder="book_ph_patient" required>
            </div>
            <div class="form-group">
              <label for="patientPhone" class="form-label" data-i18n="book_label_phone">Phone Number *</label>
              <input type="tel" id="patientPhone" class="form-control" placeholder="10-digit mobile number" data-i18n-placeholder="book_ph_phone" required>
            </div>
          </div>

          <!-- Dynamic Home Address Field (Hidden by default unless home collection is selected) -->
          <div class="form-group" id="homeAddressGroup" style="display: none;">
            <label for="homeAddress" class="form-label" data-i18n="book_label_addr">Residential Address (for Home Collection in Ponneri area) *</label>
            <textarea id="homeAddress" class="form-control" placeholder="House/Flat number, Street name, Landmark, Ponneri" data-i18n-placeholder="book_ph_addr"></textarea>
          </div>

          <div style="margin-top: 12px;">
            <button type="submit" class="btn btn-primary" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              <span data-i18n="book_btn_submit">Confirm &amp; Send to WhatsApp</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal 3: Confirmation Dialog -->
  <div class="modal-backdrop" id="confirmationModal" role="dialog" aria-modal="true">
    <div class="modal-container" style="max-width: 480px;">
      <div class="modal-body" id="confirmationDetails">
        <!-- Dynamically rendered -->
      </div>
    </div>
  </div>

  <!-- Modal 4: Quick Search Overlay -->
  <div class="search-overlay" id="searchOverlay" role="dialog" aria-modal="true" aria-labelledby="searchOverlayTitle">
    <div class="search-overlay-box">
      <div class="search-overlay-input-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="searchOverlayInput" class="search-overlay-input" placeholder="Type test name (e.g. CBC, KFT, LFT, ECG, Sugar)..." data-i18n-placeholder="search_ph" aria-label="Search all lab tests">
        <button type="button" class="modal-close-btn" aria-label="Close search overlay">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="search-results-list" id="searchResultsList">
        <div style="padding: 16px; text-align: center; color: var(--text-muted); font-size: 0.9rem;" data-i18n="search_default_hint">
          Type to search any diagnostic test, service, or health package...
        </div>
      </div>
    </div>
  </div>

  <!-- Floating WhatsApp Quick Connect Button -->
  <a href="https://wa.me/919843696625?text=Hello%20Sri%20Durgaa%20Clinical%20Laboratory%2C%20I%20would%20like%20to%20inquire%20about%20a%20diagnostic%20test." 
     target="_blank" 
     rel="noopener" 
     class="floating-whatsapp-btn" 
     aria-label="Chat with Sri Durgaa Lab on WhatsApp"
     title="Chat with us on WhatsApp (+91 98436 96625)"
     data-i18n-title="floating_wa_title">
    <span class="whatsapp-pulse"></span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <span class="whatsapp-label" data-i18n="floating_wa_label">Book on WhatsApp</span>
  </a>

  <!-- Toast Container -->
  <div class="toast-container" id="toastContainer" aria-live="polite"></div>

  <!-- JavaScript -->
  <script src="js/translations.js"></script>
  <script src="js/main.js"></script>
</body>
</html>
